# ANAMNE - Environment Configuration
# Copy this file to .env, then run: anamne init

# ----- LLM API key (pick ONE; first non-empty wins) -----

# Best quality, paid (~$0.003/commit). Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Free tier, good quality. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# ----- Optional -----

# Where to store the memory store (default: ~/.anamne)
# ANAMNE_DATA_DIR=/path/to/anamne

# Required for `anamne export --signed` / `anamne import-memory --verify`.
# Use a long random string; share with anyone who needs to verify bundles
# you produce, but otherwise keep it private.
# ANAMNE_SIGN_KEY=

# Required for `anamne export --encrypt` / `anamne import-memory --decrypt`.
# AES-GCM-256 key (derived via SHA-256 from this passphrase).
# ANAMNE_ENC_KEY=

# Required for `anamne key-rotate` (re-sign signed bundles with a new key).
# Set to the OLD signing key while ANAMNE_SIGN_KEY holds the new one.
# ANAMNE_SIGN_KEY_OLD=
